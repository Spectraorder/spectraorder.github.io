<!-- Page transitions, ported from the CHORD lab site: the content fades up and out (with the navbar and
     footer fading alongside) on an internal link click, then the next page's content rises in. The next page and its images are loaded (or prefetched on hover)
     before the fade-out starts, so there is no blank screen while it loads.
     Inlined rather than in _sass so PurgeCSS cannot strip it. -->
<style>
  @keyframes page-arrive {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes page-fade-in {
    from {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    /* Rise in once the loader lifts (or straight away when the loader isn't running, e.g. without JS). */
    html:not(.page-loading) [role="main"],
    html.page-loading.page-ready [role="main"] {
      /* backwards, not both: a transform left on the container would break position: fixed inside it */
      animation: page-arrive 320ms ease-out backwards;
    }
    /* The navbar and footer fade in with it, without moving. */
    html:not(.page-loading) #navbar,
    html.page-loading.page-ready #navbar,
    html:not(.page-loading) body > footer,
    html.page-loading.page-ready body > footer {
      animation: page-fade-in 320ms ease-out backwards;
    }
  }

  /* Loader: a cover in the page color until the page (images, fonts) has fully loaded. It is drawn
     with pseudo-elements on <html>, so it exists before <body> is parsed and needs no markup.
     The progress readout (a number over a filling bar) only appears if loading takes longer than
     ~250ms, so fast loads show no loader at all. */
  html.page-loading::before,
  html.page-loading::after {
    content: "";
    position: fixed;
    z-index: 2000;
    pointer-events: none;
    transition:
      opacity 280ms ease,
      visibility 0s linear 280ms;
  }
  html.page-loading::before {
    /* Covers the whole window, navbar included, so nothing shows half-loaded (e.g. icon fonts). */
    inset: 0;
    background: var(--global-bg-color, #faf9f6);
  }
  html.page-loading::after {
    /* The number comes from data-load-progress and the bar width from --load-fill (e.g. "42%"), both
       set by the script below. The width is not computed with calc() here: the site's HTML minifier
       mangles custom properties inside it (var(--x) becomes var( - - x)), dropping the background. */
    content: attr(data-load-progress);
    top: 50%;
    left: 50%;
    width: 120px;
    margin: -18px 0 0 -60px;
    padding-bottom: 12px;
    text-align: center;
    font: 500 12px/16px "JetBrains Mono", ui-monospace, Menlo, monospace;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    color: var(--global-text-color-light, #6b6359);
    background:
      linear-gradient(var(--global-theme-color, #2949a8), var(--global-theme-color, #2949a8)) 0 100% /
        var(--load-fill, 0%) 2px no-repeat,
      linear-gradient(var(--global-divider-color, rgba(31, 27, 22, 0.08)), var(--global-divider-color, rgba(31, 27, 22, 0.08))) 0
        100% / 100% 2px no-repeat;
    opacity: 0;
    animation: loader-appear 200ms ease 250ms forwards;
  }
  html.page-loading.page-ready::before,
  html.page-loading.page-ready::after {
    opacity: 0;
    visibility: hidden;
    animation: none;
  }
  @keyframes loader-appear {
    to {
      opacity: 1;
    }
  }
</style>
<script>
  // Hold the cover until everything has loaded (window load + web fonts), but never longer than
  // MAX_LOADER_MS, so one slow image can't keep the page hidden. While it waits, count up the share
  // of the page's images (plus the HTML itself) that have finished; when the page is ready the
  // number runs to 100 before the cover fades.
  (() => {
    const MAX_LOADER_MS = 3000;
    const LOADER_DELAY_MS = 250; // matches the loader-appear delay in the CSS above
    const root = document.documentElement;
    const startedAt = performance.now();
    root.classList.add("page-loading");

    let done = false; // the page is ready (or the time limit hit)
    let hidden = false; // the cover has started fading out
    let images = [];
    let target = 5;
    let shown = 0;
    let last = startedAt;

    const hide = () => {
      if (hidden) return;
      hidden = true;
      root.classList.add("page-ready");
      // Drop the cover entirely once it has faded, so it never sits over the page.
      setTimeout(() => {
        root.classList.remove("page-loading", "page-ready");
        delete root.dataset.loadProgress;
        root.style.removeProperty("--load-fill");
      }, 400);
    };
    const reveal = () => {
      if (done) return;
      done = true;
      target = 100;
      // Too quick for the loader to have appeared: just show the page.
      if (performance.now() - startedAt < LOADER_DELAY_MS) return hide();
      // Otherwise let the number reach 100 first, without holding the page for long.
      setTimeout(hide, 350);
    };

    const measure = () => {
      if (done) return;
      const total = images.length + 1;
      const finished = (document.readyState === "loading" ? 0 : 1) + images.filter((img) => img.complete).length;
      target = Math.max(target, Math.min(99, Math.round((finished / total) * 100)));
    };
    document.addEventListener("DOMContentLoaded", () => {
      images = [...document.images].filter((img) => img.loading !== "lazy");
    });

    // Ease toward the target by elapsed time, so the count stays smooth even if frames are dropped.
    const tick = (now) => {
      if (hidden) return;
      measure();
      shown += (target - shown) * (1 - Math.exp(-(now - last) / (done ? 50 : 150)));
      last = now;
      if (target - shown < 0.5) shown = target;
      const value = String(Math.floor(shown));
      if (root.dataset.loadProgress !== value) {
        root.dataset.loadProgress = value;
        root.style.setProperty("--load-fill", value + "%");
      }
      if (done && shown >= 100) return hide();
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);

    const loaded = new Promise((resolve) =>
      document.readyState === "complete" ? resolve() : window.addEventListener("load", resolve, { once: true })
    );
    Promise.all([loaded, document.fonts ? document.fonts.ready : null]).then(reveal, reveal);
    setTimeout(reveal, MAX_LOADER_MS);
  })();
</script>
<script>
  (() => {
    const motionPreference = matchMedia("(prefers-reduced-motion: reduce)");
    const MAX_WAIT = 1500; // never hold a click longer than this waiting for the next page
    const preloads = new Map();
    let exitAnimation;
    let chromeAnimations = [];
    let navigationPending = false;

    // The destination URL if this link goes to another page of this site, otherwise null
    // (other sites, files, anchors on this page, and the current page navigate normally).
    const pageDestination = (link) => {
      if (!link || link.hasAttribute("download") || (link.target && link.target !== "_self")) return null;
      const destination = new URL(link.href, location.href);
      if (
        destination.origin !== location.origin ||
        destination.pathname.startsWith("/assets/") ||
        !/(\/|\.html)$/.test(destination.pathname) ||
        destination.pathname === location.pathname
      )
        return null;
      return destination;
    };

    // Fetch the page into the HTTP cache, then load the images in its main content.
    const preload = (destination) => {
      const key = destination.pathname;
      if (!preloads.has(key)) {
        const loading = fetch(destination.href, { credentials: "same-origin" })
          .then((response) => (response.ok ? response.text() : ""))
          .then((html) => {
            const page = new DOMParser().parseFromString(html, "text/html");
            const images = [...page.querySelectorAll('[role="main"] img, [role="main"] video[poster]')].slice(0, 12).map((element) => {
              if (element.tagName === "VIDEO") {
                const poster = new Image();
                poster.src = new URL(element.getAttribute("poster"), destination).href;
                return poster.decode().catch(() => {});
              }
              // Responsive images: load the same candidate the page will pick.
              const source = element.closest("picture")?.querySelector("source[srcset]");
              const image = new Image();
              image.sizes = (source || element).getAttribute("sizes") || "";
              const srcset = (source || element).getAttribute("srcset");
              if (srcset) image.srcset = srcset.replace(/(^|,\s*)(\S+)/g, (m, sep, url) => sep + new URL(url, destination).href);
              const src = element.getAttribute("src");
              if (src) image.src = new URL(src, destination).href;
              return image.decode().catch(() => {});
            });
            return Promise.all(images);
          })
          .catch(() => preloads.delete(key));
        preloads.set(key, loading);
      }
      return preloads.get(key);
    };

    // Prefetch on hover, keyboard focus, or touch, so the page is usually ready before the click.
    const warm = (event) => {
      if (navigator.connection?.saveData) return;
      const destination = pageDestination(event.target.closest?.("a[href]"));
      if (destination) preload(destination);
    };
    document.addEventListener("pointerover", warm, { passive: true });
    document.addEventListener("focusin", warm);
    document.addEventListener("touchstart", warm, { passive: true });

    // Preserve normal navigation, history, and modified/new-tab clicks.
    document.addEventListener("click", (event) => {
      const pageContent = document.querySelector('[role="main"]');
      if (
        event.defaultPrevented ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey ||
        !pageContent ||
        motionPreference.matches ||
        !pageContent.animate
      )
        return;
      const destination = pageDestination(event.target.closest("a[href]"));
      if (!destination) return;
      event.preventDefault();
      if (navigationPending) return;
      navigationPending = true;
      document.documentElement.style.cursor = "progress";
      const go = () => location.assign(destination.href);
      const ready = Promise.race([preload(destination), new Promise((resolve) => setTimeout(resolve, MAX_WAIT))]);
      ready.then(() => {
        if (!navigationPending) return;
        const timing = { duration: 160, easing: "ease-in", fill: "forwards" };
        exitAnimation = pageContent.animate(
          [
            { opacity: 1, transform: "translateY(0)" },
            { opacity: 0, transform: "translateY(-8px)" },
          ],
          timing
        );
        // The navbar and footer fade out with the content (opacity only, so they don't shift).
        chromeAnimations = [...document.querySelectorAll("#navbar, body > footer")].map((element) =>
          element.animate([{ opacity: 1 }, { opacity: 0 }], timing)
        );
        exitAnimation.finished.then(go).catch(() => {});
        // Navigate anyway if the animation stalls (e.g. the tab is hidden mid-click).
        setTimeout(() => navigationPending && go(), 400);
      });
    });

    // Restore the page when it comes back from the back/forward cache.
    window.addEventListener("pageshow", () => {
      exitAnimation?.cancel();
      exitAnimation = undefined;
      chromeAnimations.forEach((animation) => animation.cancel());
      chromeAnimations = [];
      navigationPending = false;
      document.documentElement.style.cursor = "";
    });
  })();
</script>
